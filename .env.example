# Copy to .env and fill in. .env holds a password and is ignored by git.

# The whole connection string, user and password included.
MONGO_URI=mongodb://<user>:<password>@<host>:27017/?authSource=admin

# Which database the commands work in.
MONGO_DB=cadence_eval

# The application the online parser signs in as, from my.telegram.org.
TELEGRAM_API_ID=<id>
TELEGRAM_API_HASH=<hash>

# Where the signed-in session is kept. Defaults to .telegram.session at the
# repository root, which git ignores.
TELEGRAM_SESSION=.telegram.session
