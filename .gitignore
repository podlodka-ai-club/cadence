# Session working material — see CLAUDE.md
/untracked/*
!/untracked/.gitkeep

# xmemory CLI credential: holds a plaintext API key, must never be committed
.xmemrc.json

# Python bytecode
__pycache__/
*.py[cod]

# Database credentials: holds a password, must never be committed
.env

# A signed-in Telegram account: whoever holds it is the account
.telegram.session*

# Local virtualenv
.venv/

# Which cards a panel run works on: personal, and different every run
admin/config.json
